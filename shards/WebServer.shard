{{shard "WebServer"}}

{{$name := "web-server"}}

{{begin "Routes"}}
{{set "name" "-route"}}
{{prefix "name" $name}}
{{set "runsOn" "-service"}}
{{prefix "runsOn" $name}}
{{receive "host"}}

{{begin "Deployments"}}
{{set "name" $name}}
{{receive "image"}}
{{set "imagePullSecret" "ghcr-creds"}}
{{receive "runsOn"}}
{{set "component" "server"}}
{{receive "containerPort"}}

{{begin "Services"}}
{{bind "name" "Routes@runsOn"}}
{{set "runsOn" $name}}
{{set "port" 80}}
{{bind "targetPort" "Deployments@containerPort"}}

{{seal}}
